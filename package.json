{
  "name": "gabopay",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "dev:api": "cd apps/api && poetry run uvicorn apps.api.main:app --reload",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "dev:docs": "npm run dev --workspace=apps/docs",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "build:dashboard": "npm run build --workspace=apps/dashboard",
    "build:docs": "npm run build --workspace=apps/docs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}