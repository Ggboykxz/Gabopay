# App
APP_ENV=development
SECRET_KEY=your-secret-key-here-min-16-chars
ENCRYPTION_KEY=your-encryption-key-base64

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gabopay
REDIS_URL=redis://localhost:6379/0

# Providers
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_URL=http://localhost:8000/v1/callbacks/airtel

MOOV_BASE_URL=https://api.moov.africa
MOOV_API_KEY=
MOOV_CALLBACK_URL=http://localhost:8000/v1/callbacks/moov

CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Dashboard auth
JWT_SECRET=your-jwt-secret-here-min-16-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email (KYC notifications, receipts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@gabopay.ga

# Fees & Limits
PLATFORM_FEE_PERCENTAGE=1.5
MIN_CHARGE_AMOUNT=500
MAX_CHARGE_AMOUNT=5000000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
ALLOWED_ORIGINS=["https://gabopay.ga"]

# API URL (for production docker compose)
API_URL=https://api.gabopay.ga
